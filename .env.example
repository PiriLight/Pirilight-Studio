# Public by design: the publishable key is safe in the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Used to build trusted password-recovery redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable only after the operational migrations exist in the target Supabase project.
# When omitted, Commercial/Clients stay in demonstration mode; there is no dual-write.
PIRILIGHT_OPERATIONAL_DATA_SOURCE=mock
